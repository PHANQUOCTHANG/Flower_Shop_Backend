generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- ENUMS ---

enum UserRole {
  CUSTOMER
  ADMIN
  STAFF
}

enum AuthProvider {
  LOCAL
  GOOGLE
  FACEBOOK
}

// --- MODELS ---

model User {
  id            String       @id @default(uuid())
  fullName      String       @map("full_name") @db.VarChar(150)
  email         String       @unique @db.VarChar(150)
  phone         String?      @db.VarChar(20)
  password      String?      @db.VarChar(255)
  provider      AuthProvider @default(LOCAL)
  providerId    String?      @map("provider_id") @db.VarChar(255)
  role          UserRole     @default(CUSTOMER)
  avatar        String?      @db.Text
  isActive      Boolean      @default(true) @map("is_active")
  emailVerified Boolean      @default(false) @map("email_verified")
  
  lastLogin     DateTime?    @map("last_login") @db.Timestamptz
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt     DateTime?    @map("deleted_at") @db.Timestamptz

  // Quan hệ
  refreshTokens RefreshToken[]
  cart          Cart?
  orders        Order[]
  addresses     Address[]
  reviews       Review[]
  chats         Chat[]       @relation("UserChats")
  adminChats    Chat[]       @relation("AdminChats")
  messages      Message[]

  @@map("users")
  @@index([deletedAt])
  @@index([provider, providerId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique @db.Text
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
  @@index([userId])
}

model Otp {
  id        String   @id @default(uuid())
  email     String   @db.VarChar(255)
  otpHash   String   @map("otp_hash") @db.Text
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  verified  Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("otps")
  @@index([email])
}

model Category {
  id              String            @id @default(uuid())
  name            String            @db.VarChar(150)
  slug            String            @unique @db.VarChar(150)
  description     String?           @db.Text
  parentId        String?           @map("parent_id")
  thumbnailUrl    String?           @map("thumbnail_url") @db.Text
  sortOrder       Int               @default(0) @map("sort_order")
  status          String            @default("active") @db.VarChar(20)
  metaTitle       String?           @map("meta_title") @db.VarChar(255)
  metaDescription String?           @map("meta_description") @db.Text
  
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt       DateTime?         @map("deleted_at") @db.Timestamptz

  parent   Category?         @relation("CategoryToCategory", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[]        @relation("CategoryToCategory")
  products ProductCategory[]

  @@map("categories")
  @@index([slug])
  @@index([parentId])
}

model Product {
  id                String    @id @default(uuid())
  name              String    @db.VarChar(255)
  slug              String    @unique @db.VarChar(255)
  shortDescription  String?   @map("short_description") @db.Text
  description       String?   @db.Text
  price             Decimal   @db.Decimal(12, 2)
  comparePrice      Decimal?  @map("compare_price") @db.Decimal(12, 2)
  sku               String?   @unique @db.VarChar(100)
  thumbnailUrl      String?   @map("thumbnail_url") @db.Text
  thumbnailPublicId String?   @map("thumbnail_public_id") @db.VarChar(255)
  status            String    @default("active") @db.VarChar(20)
  
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz

  // Quan hệ
  categories ProductCategory[]
  images     ProductImage[]
  cartItems  CartItem[]
  orderItems OrderItem[]
  reviews    Review[]

  @@map("products")
  @@index([sku])
  @@index([slug])
  @@index([status])
  @@index([price])
}

model ProductCategory {
  productId  String   @map("product_id")
  categoryId String   @map("category_id")
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@map("product_categories")
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String   @map("product_id")
  imageUrl  String   @map("image_url") @db.Text
  publicId  String   @map("public_id") @db.VarChar(255)
  isPrimary Boolean  @default(false) @map("is_primary")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
  @@index([productId])
}

model Cart {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String   @map("cart_id")
  productId String   @map("product_id")
  quantity  Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("cart_items")
  @@index([cartId])
}

model Order {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  totalPrice      Decimal  @map("total_price") @db.Decimal(12, 2)
  status          String   @default("pending") @db.VarChar(20)
  
  name            String?  @map("name") @db.Text
  shippingAddress String?  @map("shipping_address") @db.Text
  shippingPhone   String?  @map("shipping_phone") @db.VarChar(20)
  paymentMethod   String?  @map("payment_method") @db.VarChar(50)
  paymentStatus   String   @default("unpaid") @map("payment_status") @db.VarChar(20)
  note            String?  @map("note") @db.Text

  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user  User        @relation(fields: [userId], references: [id])
  items OrderItem[]

  @@map("orders")
  @@index([userId])
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String  @map("order_id")
  productId String  @map("product_id")
  quantity  Int
  price     Decimal @db.Decimal(12, 2)
  subtotal  Decimal @db.Decimal(12, 2)
  isReview  Boolean @default(false) @map("is_review")

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([orderId, productId]) 
  @@map("order_items")
  @@index([orderId])
}

model Review {
  id        String   @id @default(uuid())
  rating    Int      @default(5)
  content   String?  @db.Text
  isVisible Boolean  @default(true) @map("is_visible")
  
  userId    String   @map("user_id")
  productId String   @map("product_id")
  orderId   String?  @map("order_id")

  user    User    @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  media   ReviewMedia[]

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  @@map("reviews")
  @@index([productId])
  @@index([userId])
}

model ReviewMedia {
  id       String @id @default(uuid())
  reviewId String @map("review_id")
  url      String @db.Text
  publicId String @map("public_id") @db.VarChar(255)
  type     String @default("image") @db.VarChar(20) // "image" hoặc "video"

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@map("review_media")
}

model Chat {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id")
  adminId        String?   @map("admin_id")
  status         String    @default("open") @db.VarChar(20)
  lastMessageAt  DateTime? @map("last_message_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  user     User      @relation("UserChats", fields: [userId], references: [id])
  admin    User?     @relation("AdminChats", fields: [adminId], references: [id])
  messages Message[]

  @@map("chats")
  @@index([userId])
  @@index([status])
}

model Message {
  id         String   @id @default(uuid()) @db.Uuid
  chatId     String   @map("chat_id") @db.Uuid
  senderId   String   @map("sender_id")
  senderRole String   @map("sender_role") @db.VarChar(10)
  content    String   @db.Text
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  chat   Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender User @relation(fields: [senderId], references: [id])

  @@map("messages")
  @@index([chatId])
}

model Address {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  name            String   @db.Text
  phone           String   @db.VarChar(20)
  
  provinceCode    String   @map("province_code") @db.VarChar(10)
  provinceName    String   @map("province_name") @db.VarChar(100)
  districtCode    String   @map("district_code") @db.VarChar(10)
  districtName    String   @map("district_name") @db.VarChar(100)
  wardCode        String   @map("ward_code") @db.VarChar(10)
  wardName        String   @map("ward_name") @db.VarChar(100)
  streetDetail    String   @map("street_detail") @db.Text
  
  isDefault       Boolean  @default(false) @map("is_default")
  
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("addresses")
  @@index([userId])
}