{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "rootDir": "./src",
    "outDir": "./dist",

    // --- Cấu hình Alias ---
    "baseUrl": "./src",
    "paths": {
      "@/*": ["*"]
    },

    // --- Cấu hình bổ sung để sửa lỗi Deploy ---
    "types": ["node", "multer"], // Sửa lỗi Namespace 'global.Express' has no exported member 'Multer'
    "typeRoots": ["./node_modules/@types", "./src/types"], // Chỉ định nơi chứa các file .d.ts tùy chỉnh của bạn
    
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true, // Quan trọng: Bỏ qua kiểm tra lỗi trong node_modules để build nhanh và ít lỗi vặt
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "moduleResolution": "node" // Giúp TS tìm kiếm module theo kiểu Node.js chuẩn hơn
  },
  "include": [
    "src/**/*",
    "src/types/**/*.d.ts" // Đảm bảo các file định nghĩa kiểu tự tạo cũng được quét qua
  ],
  "exclude": ["node_modules", "dist"]
}